+        return false;
+    hash(shared_key, 32);
+
+    SharedKeyCacheEntry &e = sharedKeyCache[sharedKeyCacheNext];
+    sharedKeyCacheNext = (sharedKeyCacheNext + 1) % SHARED_KEY_CACHE_SIZE;
+    memcpy(e.publicKey, remotePublic, 32);
+    memcpy(e.sharedKey, shared_key, 32);
+    e.valid = true;
+    return true;
 }
 
